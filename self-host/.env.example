# Copy this file to .env and edit. NEVER commit .env (it is in .gitignore).

# n8n image tag. Use "latest" for a demo; pin an exact version from the n8n release page for a client.
N8N_VERSION=latest

# Public hostname and URL (DNS A record must point at the server). WEBHOOK_URL needs the trailing slash.
N8N_HOST=n8n.example.com
WEBHOOK_URL=https://n8n.example.com/

# IANA timezone; controls the 08:00 / 17:30 Schedule Triggers. Examples: America/New_York, Europe/London, Australia/Sydney
GENERIC_TIMEZONE=America/New_York

# Generate once with:  openssl rand -hex 32
# Store a copy in the client's password manager. Without it, saved credentials cannot be decrypted after a restore.
N8N_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-hex-32

# Database (internal to the Docker network, never exposed). Use a long random password.
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me-use-a-long-random-password
POSTGRES_DB=n8n
