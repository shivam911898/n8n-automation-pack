              "display": true,
              "type": "string",
              "canBeUsed": true
            },
            {
              "id": "Gmail link",
              "displayName": "Gmail link",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsed": true
            }
          ]
        },
        "options": {
          "cellFormat": "RAW"
        }
      },
      "id": "095e78c9-261c-500a-86bf-6cbb580ce66b",
      "name": "Append to Invoice Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1150,
        300
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "20d90a31-ff0b-55b0-9d5a-4435b08d2371",
              "leftValue": "={{ $('Parse Extraction').item.json.needsReview }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "16f82229-b59c-5b95-999d-58bbfcc6261d",
      "name": "Needs Review?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1380,
        300
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "={{ $('Config').first().json.slackChannelId }}",
          "mode": "id"
        },
        "text": "={{ ':mag: *Document needs review* (' + $('Parse Extraction').item.json.reviewReason + ')\\n' + 'Vendor: ' + ($('Parse Extraction').item.json.vendor || '?') + ' | No: ' + ($('Parse Extraction').item.json.number || '?') + ' | Total: ' + $('Parse Extraction').item.json.total + ' ' + $('Parse Extraction').item.json.currency + '\\nFrom: ' + $('Parse Extraction').item.json.from + ' | File: ' + $('Parse Extraction').item.json.fileName + '\\n<' + $('Parse Extraction').item.json.gmailLink + '|Open email>' }}",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
      "id": "a1cb5acb-23f8-521d-b0b6-6f3b33e0a10a",
      "name": "Slack Review Alert",
