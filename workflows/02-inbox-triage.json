    {
      "parameters": {
        "jsCode": "const today = $now.toFormat('yyyy-MM-dd');\nconst rows = $input.all().map((i) => i.json).filter((r) => String(r.Date || '').slice(0, 10) === today);\nconst counts = { sales: 0, support: 0, invoice: 0, spam: 0 };\nfor (const r of rows) {\n  const c = String(r.Category || '').toLowerCase();\n  if (c in counts) counts[c] += 1;\n}\nconst urgent = rows.filter((r) => String(r['Needs human']).toLowerCase() === 'yes' || String(r.Priority).toLowerCase() === 'high');\nconst lines = [\n  '*Inbox digest for ' + today + '* - ' + rows.length + ' emails triaged',\n  'Sales: ' + counts.sales + ' | Support: ' + counts.support + ' | Invoices: ' + counts.invoice + ' | Spam filtered: ' + counts.spam,\n];\nif (urgent.length) {\n  lines.push('', ':rotating_light: *Needs a human (' + urgent.length + ')*');\n  for (const r of urgent.slice(0, 8)) lines.push('- ' + r.From + ': ' + r.Subject + ' (' + r.Summary + ')');\n  if (urgent.length > 8) lines.push('...and ' + (urgent.length - 8) + ' more in the Triage Log.');\n} else if (rows.length) {\n  lines.push('', 'Nothing urgent. All drafts are waiting in Gmail Drafts.');\n} else {\n  lines.push('', 'No emails were triaged today.');\n}\nreturn [{ json: { text: lines.join('\\n') } }];\n"
      },
