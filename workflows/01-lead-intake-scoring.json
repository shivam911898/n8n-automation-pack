              "name": "email",
              "value": "={{ String($json.body.email || '').trim().toLowerCase().slice(0, 200) }}",
              "type": "string"
            },
            {
              "id": "2b39b73a-e1a0-5cd8-90e3-d7be297a473c",
              "name": "company",
              "value": "={{ String($json.body.company || '').trim().slice(0, 160) }}",
              "type": "string"
            },
