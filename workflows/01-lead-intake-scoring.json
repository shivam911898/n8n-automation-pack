              "name": "website",
              "value": "={{ String($json.body.website || '').trim().slice(0, 200) }}",
              "type": "string"
            },
            {
              "id": "2424863b-1ca5-5cd7-a4ec-e11b33f314bd",
              "name": "budget",
              "value": "={{ String($json.body.budget || '').trim().slice(0, 60) }}",
