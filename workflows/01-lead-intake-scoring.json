            },
            {
              "id": "64c4b076-63b8-5393-a7f1-05f9171c7816",
              "name": "source",
              "value": "={{ String($json.body.source || $json.query.source || 'web-form').slice(0, 60) }}",
              "type": "string"
            },
            {
              "id": "90479871-9dc9-5ad6-821c-dee5e9ac27c4",
              "name": "receivedAt",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            },
            {
              "id": "0d714024-c919-56f4-9b5b-5abd1ee32de2",
              "name": "isValid",
              "value": "={{ /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(String($json.body.email || '').trim()) && String($json.body.message || '').trim().length > 0 && !$json.body._hp }}",
              "type": "boolean"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
